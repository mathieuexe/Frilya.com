# ---------------------------------------------------------------------------
# Copier ce fichier en ".env" (local) et renseigner les mêmes variables dans
# Vercel > Settings > Environment Variables (production).
# ---------------------------------------------------------------------------

# --- PostHog : mesure d'audience côté navigateur (clé PUBLIQUE, sans risque)
# Projet PostHog > Settings > Project > Project API Key
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Région du projet : UE (défaut) ou US
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- PostHog : lecture des données pour l'onglet Statistique de l'admin
# SECRET : uniquement côté serveur (api/posthog-query.ts), jamais préfixé VITE_
# PostHog > Settings > Personal API keys > créer une clé avec le scope "query:read"
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Identifiant numérique du projet (visible dans l'URL PostHog : /project/12345)
POSTHOG_PROJECT_ID=12345
# API de lecture : https://eu.posthog.com (défaut) ou https://us.posthog.com
POSTHOG_HOST=https://eu.posthog.com

# --- Supabase (déjà utilisé par api/impersonate.ts et api/posthog-query.ts)
VITE_SUPABASE_URL=https://bkrfulpstfhpnlrwocdt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Emails transactionnels (Resend)
VITE_RESEND_API_KEY=

# --- Stripe
STRIPE_SECRET_KEY=
